# Copy this file to .env and fill in your keys when you have them.
# The system runs fine without these -- it just degrades gracefully
# (rule-based reasoning only, no LLM review, no live Razorpay actions /
# bank validation, and the dashboard's "Hey Vault" voice assistant
# returns a clear error telling you to set GEMINI_API_KEY instead of a
# stack trace). Accounts, sessions, and manual transactions work always.
#
# IMPORTANT: .env is gitignored ON PURPOSE -- it holds real credentials.
# Never commit it to any repo. Fresh clones copy this template and fill
# in their own keys locally.

ANTHROPIC_API_KEY=

# RazorpayX / Razorpay test-mode keys. With these set, bank "connect" runs
# real RazorpayX fund-account validation (test mode) and /flags'
# high-confidence actions go live against Razorpay. Without them, both
# clearly-labeled simulated modes run instead. Test keys start with rzp_test.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Powers /chat -- the dashboard's "Hey Vault" assistant. Free key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model override (defaults to gemini-2.0-flash)
GEMINI_MODEL=

# Optional: secret used to sign session cookies. If unset, the server
# generates data/.secret on first run (fine for a local demo). Set this
# to a long random string for any real deployment.
PMA_SECRET_KEY=
